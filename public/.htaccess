Options -MultiViews
RewriteEngine On
RewriteBase /

# Static file extensions — serve directly, no rewrite
RewriteRule \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map|json)$ - [L]

# PHP api/ folder — pass through
RewriteRule ^api/ - [L]

# Existing files and directories — serve as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else → React Router
RewriteRule ^ /index.html [L]


# Cache: index.html must always be revalidated, otherwise the browser keeps
# an old copy that points to an old bundle (e.g. no NQL Mode selector).
# Bundles in /assets carry a hash in their name: they can be cached for good.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^index-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
